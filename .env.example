# ---------------------------------------------------------------------------
# GiroLucro — variáveis de ambiente
#
# Copie para `.env` (local) ou cole na Vercel em Settings → Environment Variables.
# `.env` e `.env*.local` estão no .gitignore — nunca comite valores reais.
# ---------------------------------------------------------------------------

# --- Banco de dados (obrigatória) ------------------------------------------
# Postgres gerenciado (Neon, Supabase, RDS…) ou local.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/girolucro"

# Limite de conexões por instância do app (opcional).
# Em serverless (Vercel + Neon) ajuda a não estourar o limite do banco.
# DATABASE_POOL_MAX=3

# --- Administração / setup (obrigatória em produção) -----------------------
# Protege /admin e o setup de tabelas (/api/admin/setup?token=...).
# Use um valor longo e aleatório.
ADMIN_SETUP_TOKEN="troque-por-um-token-longo-e-aleatorio"

# --- Endereço público do app ----------------------------------------------
# Usado em links de e-mail, retorno do Mercado Pago e webhook.
APP_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_URL="https://girolucro.app.br"

# --- Pagamentos (Mercado Pago) --------------------------------------------
# Sem o access token o app funciona, mas não gera cobrança real.
# MERCADO_PAGO_ACCESS_TOKEN="APP_USR-..."
# MERCADO_PAGO_WEBHOOK_SECRET="segredo-do-webhook"
# Modo demonstração: libera o Pro sem cobrar (apenas em desenvolvimento).
# BILLING_DEMO_MODE="true"

# --- E-mail transacional (Resend) -----------------------------------------
# Sem chave, o app salva tudo no banco e apenas não envia e-mails.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="GiroLucro <contato@girolucro.app.br>"
# CONTACT_TO_EMAIL="contato@girolucro.app.br"   # cópia das mensagens do /contato
# EMAIL_DEV_MODE="true"   # em dev: links de recuperação no log e envio SIMULADO
#                      (permite testar recibo/reembolso/lembretes sem provedor)

# --- Notificações push (Web Push / VAPID) ---------------------------------
# Gere com: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="B..."
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:contato@girolucro.app.br"

# --- Rotinas automáticas (cron) -------------------------------------------
# Protege /api/cron/retention (limpeza por prazo de retenção) e
# /api/cron/reminders (lembretes de pós-venda por e-mail).
# Se não definir, o ADMIN_SETUP_TOKEN é aceito como token do cron.
# CRON_SECRET="outro-token-longo-e-aleatorio"
# Roda os lembretes também fora de produção (apenas em desenvolvimento).
# RUN_CRON_LOCAL="true"
# Token usado por /api/notifications/send quando chamado por outro serviço.
# NOTIFICATION_API_TOKEN="..."

# --- Medição de visitas ----------------------------------------------------
# "off" desliga completamente o medidor de visitas (analytics de 1º domínio).
# NEXT_PUBLIC_ANALYTICS="off"
